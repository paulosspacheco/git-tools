#!/bin/bash
# =============================================================================
# git-install.sh — Instalação global das ferramentas Git + integração Lazarus
# =============================================================================
# Copia todos os scripts git-tools para /usr/local/bin, tornando-os
# disponíveis em qualquer pasta do sistema. Opcionalmente gera um arquivo XML
# para importar as ferramentas no Lazarus (Tools → Configure External Tools → Import)
# e adiciona aliases no ~/.bashrc.
#
# Uso: ./git-install.sh
#
# Versão: 2.4.0
# =============================================================================

INSTALL_DIR="/usr/local/bin"
SCRIPT_DIR="$(dirname "$0")"

SCRIPTS=(
  git-lib.sh
  git-ini.sh
  git-config.sh
  git-hook.sh
  git-feat.sh
  git-fix.sh
  git-breaking.sh
  git-version.sh
  version-pas-inc.sh
  git-generator-lcl.sh
  git-release.sh
  git-changelog.sh
  git-docs.sh
)

echo "🚀 Instalando git-tools em $INSTALL_DIR"

for SCRIPT in "${SCRIPTS[@]}"; do
  SRC="$SCRIPT_DIR/$SCRIPT"

  if [ ! -f "$SRC" ]; then
    echo "❌ Arquivo não encontrado: $SRC" >&2
    exit 1
  fi

  sudo cp "$SRC" "$INSTALL_DIR/$SCRIPT"
  sudo chmod +x "$INSTALL_DIR/$SCRIPT"
  echo "  ✔ $SCRIPT"
done

echo "✔ Scripts instalados com sucesso"

# =============================================================================
# Integração com Lazarus (via geração de XML para importação manual)
# =============================================================================

echo ""
echo "🔧 Gerando arquivo de integração para o Lazarus..."
XML_FILE="lazarus.git-tools.xml"

# Lista das ferramentas a serem incluídas no XML
# Formato: "Título|script|parâmetros"
TOOLS=(
  "Git Feat|git-feat.sh|\$Prompt('Descreva a funcionalidade adicionadas ao projeto:')"
  "Git Fix|git-fix.sh|\$Prompt('Descreva a correção realizada:')"
  "Git Breaking|git-breaking.sh|\$Prompt('Breaking change (impacto):')"
  "Git Release|git-release.sh|"
  "Git Version Inc|version-pas-inc.sh|"
  "Git docs|git-docs.sh|\$Prompt('Descreva o tipo de documento adicionado ao projeto):')"
  "Git Changelog|git-changelog.sh"
  "Git Changelog HTML|git-changelog.sh|--html"
)

# Gerar XML
echo '<?xml version="1.0" encoding="UTF-8"?>' > "$XML_FILE"
echo "<CONFIG Version=\"3\" Count=\"${#TOOLS[@]}\">" >> "$XML_FILE"

idx=1
for tool in "${TOOLS[@]}"; do
  IFS='|' read -r name script params <<< "$tool"
  echo "  <Tool$idx>" >> "$XML_FILE"
  echo "    <Title Value=\"$name\"/>" >> "$XML_FILE"
  echo "    <Filename Value=\"$INSTALL_DIR/$script\"/>" >> "$XML_FILE"
  echo "    <CmdLineParams Value=\"$params\"/>" >> "$XML_FILE"
  echo "    <WorkingDirectory Value=\"\$ProjPath()\"/>" >> "$XML_FILE"
  echo "    <Scanners Count=\"1\">" >> "$XML_FILE"
  echo "      <Item1 Value=\"FPC\"/>" >> "$XML_FILE"
  echo "    </Scanners>" >> "$XML_FILE"
  echo "  </Tool$idx>" >> "$XML_FILE"
  ((idx++))
done
echo "</CONFIG>" >> "$XML_FILE"

echo "✔ Arquivo gerado: $XML_FILE"
echo ""
echo "👉 Para integrar com o Lazarus:"
echo "   1. Abra o Lazarus"
echo "   2. Acesse Tools → Configure External Tools → Import"
echo "   3. Selecione o arquivo $XML_FILE"
echo "   4. Reinicie o Lazarus"

# =============================================================================
# Configuração de aliases no .bashrc (opcional)
# =============================================================================

echo ""
echo "🔧 Configuração de aliases no bash"
read -rp "Adicionar aliases para os scripts no ~/.bashrc? [S/n]: " ADD_ALIASES
if [[ "$ADD_ALIASES" =~ ^[Nn]$ ]]; then
  echo "⚠ Aliases não adicionados"
else
  BASHRC="$HOME/.bashrc"
  ALIAS_BLOCK_START="# ============================================"
  ALIAS_BLOCK_END="# ============================================"
  ALIAS_HEADER="# GIT-TOOLS ALIASES - Gerado por git-install.sh"
  ALIAS_LINES=()

  declare -A ALIAS_MAP=(
    ["git-feat"]="git-feat.sh"
    ["git-fix"]="git-fix.sh"
    ["git-breaking"]="git-breaking.sh"
    ["git-release"]="git-release.sh"
    ["version-pas-inc"]="version-pas-inc.sh"
    ["git-version"]="git-version.sh"
    ["git-docs"]="git-docs.sh"
    ["git-changelog"]="git-changelog.sh"
    ["git-ini"]="git-ini.sh"
    ["git-config"]="git-config.sh"
    ["git-hook"]="git-hook.sh"
  )

  for alias_name in "${!ALIAS_MAP[@]}"; do
    ALIAS_LINES+=("alias $alias_name='bash \"$INSTALL_DIR/${ALIAS_MAP[$alias_name]}\"'")
  done

  if grep -q "GIT-TOOLS ALIASES" "$BASHRC" 2>/dev/null; then
    echo "⚠ Aliases já configurados em $BASHRC. Nenhuma alteração feita."
  else
    {
      echo ""
      echo "$ALIAS_BLOCK_START"
      echo "$ALIAS_HEADER"
      echo "$ALIAS_BLOCK_END"
      for line in "${ALIAS_LINES[@]}"; do
        echo "$line"
      done
      echo "$ALIAS_BLOCK_START"
    } >> "$BASHRC"
    echo "✔ Aliases adicionados com sucesso em $BASHRC"
    echo "👉 Para usar os aliases imediatamente, execute: source ~/.bashrc"
  fi
fi

# =============================================================================

echo ""
echo "✔ Ambiente pronto!"
echo ""
echo "Exemplo de uso:"
echo "  git-ini.sh"
echo "  git-feat.sh \"nova funcionalidade\""
echo "  git-fix.sh \"correção de bug\""
echo "  git-release.sh"